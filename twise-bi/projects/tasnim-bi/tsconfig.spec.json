{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/spec",
    "types": [
      "vitest/globals"
    ],
    "paths": {
      "@tasnim/bi": [
        "./src/public-api.ts"
      ],
      "@tasnim/bi/core": [
        "./core/src/public-api.ts"
      ],
      "@tasnim/bi/visuals": [
        "./visuals/src/public-api.ts"
      ],
      "@tasnim/bi/report": [
        "./report/src/public-api.ts"
      ],
      "@tasnim/bi/admin": [
        "./admin/src/public-api.ts"
      ],
      "@tasnim/bi/modeling": [
        "./modeling/src/public-api.ts"
      ]
    }
  },
  "include": [
    "**/*.spec.ts",
    "**/*.d.ts"
  ]
}
