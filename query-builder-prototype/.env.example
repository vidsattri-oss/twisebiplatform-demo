# Copy to .env (gitignored) and fill in for anything beyond local demo use.

# 32-byte key, hex-encoded (64 hex chars), used to encrypt connection
# credentials at rest. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without this set, secrets.js uses a per-process ephemeral key — fine for
# this demo (no real credentials are stored yet), but anything encrypted
# with it becomes unreadable on restart.
CONNECTION_SECRET_KEY=
