# Copy to .env (gitignored) and fill in for anything beyond local demo use.
# `npm start` loads .env when it exists.

# 32-byte key, hex-encoded (64 hex chars), used to encrypt connection
# credentials at rest (REST tokens, SAP and database passwords). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without this set, secrets.js uses a per-process ephemeral key, so stored
# secrets become unreadable after a restart and must be entered again.
CONNECTION_SECRET_KEY=

# Hosts the REST, Google and SAP connectors may call (comma-separated).
# "*.example.com" matches subdomains; "host:port" matches that port only.
# https is required unless a host is listed exactly, and hosts that resolve to
# private addresses are refused unless listed exactly.
# Default when unset: docs.google.com,drive.google.com,drive.usercontent.google.com,*.googleusercontent.com
# Add localhost:4173 to try the REST connector against this server's sample feed:
#   http://localhost:4173/api/bi/samples/work-orders.json
BI_OUTBOUND_ALLOWED_HOSTS=docs.google.com,drive.google.com,drive.usercontent.google.com,*.googleusercontent.com,localhost:4173
