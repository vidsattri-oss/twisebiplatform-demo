{
  "name": "Operations (Al Tasnim)",
  "calculatedColumns": [
    { "table": "tasks", "name": "Delay Days", "expression": "DATEDIFF(tasks[task_date], TODAY(), DAY)", "format": "#,0" },
    { "table": "tasks", "name": "Quantity Status", "expression": "IF(tasks[actual_quantity] >= tasks[planned_quantity], \"Met\", \"Missed\")" }
  ],
  "tables": {
    "tasks": {
      "columns": {
        "task_date": { "dataType": "date", "format": "dd-MM-yyyy" }
      }
    }
  },
  "measures": [
    { "table": "tasks", "name": "Task Count", "expression": "COUNTROWS(tasks)", "format": "#,0" },
    { "table": "tasks", "name": "Actual Quantity", "expression": "SUM(tasks[actual_quantity])", "format": "#,0" },
    { "table": "tasks", "name": "Planned Quantity", "expression": "SUM(tasks[planned_quantity])", "format": "#,0" },
    { "table": "tasks", "name": "Productivity %", "expression": "DIVIDE([Actual Quantity], [Planned Quantity])", "format": "0.0%" },
    { "table": "tasks", "name": "Actual Hours", "expression": "SUM(tasks[actual_hours])", "format": "#,0.0" },
    { "table": "tasks", "name": "Productivity Status", "expression": "IF([Productivity %] >= 0.9, \"On track\", \"At risk\")" },
    { "table": "tasks", "name": "Productivity Label", "expression": "FORMAT([Productivity %], \"0.0%\") & \" of plan\"" },
    { "table": "tasks", "name": "Hours Variance", "expression": "SUMX(tasks, tasks[actual_hours] - tasks[planned_hours])", "format": "#,0.0" }
  ]
}
